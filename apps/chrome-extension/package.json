{
  "name": "chrome-extension",
  "private": true,
  "version": "3.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "clean:node_modules": "rimraf node_modules",
    "dev:background": "pnpx nodemon --exec node src/background/index.js",
    "test:unit": "node --test \"src/background/lib/*.test.js\" && node --experimental-strip-types --no-warnings --test \"pages/popup/src/lib/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "dev:ext": "node scripts/dev-extension.mjs",
    "package": "node scripts/package.mjs",
    "publish:store": "node scripts/publish.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@packages/typescript-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/chrome": "^0.0.300",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.0",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
