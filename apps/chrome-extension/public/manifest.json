{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "3.0.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "permissions": ["storage", "notifications", "alarms", "sidePanel"],
  "host_permissions": [
    "https://api.upbit.com/*",
    "https://api.bithumb.com/*",
    "https://api.binance.com/*",
    "https://api.bybit.com/*",
    "https://www.okx.com/*",
    "https://api.exchange.coinbase.com/*",
    "https://api.bitget.com/*",
    "https://api.kraken.com/*",
    "https://api.coindcx.com/*",
    "https://public.coindcx.com/*",
    "https://www.koreaexim.go.kr/*",
    "https://m.stock.naver.com/*",
    "https://open.er-api.com/*",
    "https://api.alternative.me/*",
    "https://api.coingecko.com/*",
    "https://fapi.binance.com/*",
    "https://api.dexscreener.com/*"
  ],
  "background": {
    "service_worker": "background.iife.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "popup/index.html?view=sidepanel"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": "como-logo.png"
  },
  "icons": {
    "128": "como-logo.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Space",
        "mac": "Command+Space"
      },
      "description": "__MSG_commandToggle__"
    }
  }
}
